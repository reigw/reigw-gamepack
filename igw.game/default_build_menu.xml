<?xml version="1.0"?>
<!--
build commands
[RadiantPath]: path to Radiant .. C:\Program Files\NetRadiant
[EnginePath]: path to the engine .. C:\Games\Iron Grip Warlord\

 The stock maps were compiled by q3map2 2.5.17, so the compile steps are
 Quake III's. Iron Grip's BSPs are IBSP version 48 with 12 byte brush
 sides (planeNum, shaderNum and a flag word holding canbuild), which only
 LuaDiant's q3map2 writes, as "-game igw".

 NPCs and bots also need the map's .aas (id's EAAS version 5), which
 LuaDiant's mbspc builds from such a BSP with the options the stock maps'
 were made with. The .aas holds the checksum of the whole BSP and the game
 refuses one that does not match, so mbspc has to run after the last
 q3map2 pass changing the BSP (-light included).
-->
<project version="2.0">
<var name="q3map2">"[RadiantPath]q3map2.[ExecutableType]" -v<cond value="[MonitorAddress]"> -connect [MonitorAddress]</cond> -game igw -fs_basepath "[EnginePath]" -fs_basegame base<cond value="[GameName]"> -fs_game [GameName]</cond></var>
<var name="mbspc">"[RadiantPath]mbspc.[ExecutableType]" -optimize -forcesidesvisible</var>
<build name="Q3Map2: (single) BSP -meta">
<command>[q3map2] -meta "[MapFile]"</command>
</build>
<build name="Q3Map2: (single) -vis">
<command>[q3map2] -vis "[MapFile]"</command>
</build>
<build name="Q3Map2: (single test) -vis -fast">
<command>[q3map2] -vis -fast "[MapFile]"</command>
</build>
<build name="Q3Map2: (single test) -light -fast">
<command>[q3map2] -light -fast "[MapFile]"</command>
</build>
<build name="Q3Map2: (single) -light -fast -super 2 -filter">
<command>[q3map2] -light -fast -super 2 -filter "[MapFile]"</command>
</build>
<build name="Q3Map2: (test) BSP -meta, -vis -fast, -light -fast -filter">
<command>[q3map2] -meta "[MapFile]"</command>
<command>[q3map2] -vis -saveprt -fast "[MapFile]"</command>
<command>[q3map2] -light -fast -filter "[MapFile]"</command>
</build>
<build name="Q3Map2: (final) BSP -meta, -vis, -light -fast -filter -super 2, AAS">
<command>[q3map2] -meta "[MapFile]"</command>
<command>[q3map2] -vis -saveprt "[MapFile]"</command>
<command>[q3map2] -light -fast -filter -super 2 "[MapFile]"</command>
<command>[mbspc] -bsp2aas "[BspFile]"</command>
</build>
<build name="Q3Map2: (final) BSP -meta, -vis, -light -fast -filter -super 2 -bounce 8, AAS">
<command>[q3map2] -meta "[MapFile]"</command>
<command>[q3map2] -vis -saveprt "[MapFile]"</command>
<command>[q3map2] -light -fast -super 2 -filter -bounce 8 "[MapFile]"</command>
<command>[mbspc] -bsp2aas "[BspFile]"</command>
</build>
<separator />
<build name="MBSPC: (single) AAS for NPCs and bots">
<command>[mbspc] -bsp2aas "[BspFile]"</command>
</build>
</project>
